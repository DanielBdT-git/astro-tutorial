import "../styles/global.css"
import BaseLayout from "../layouts/baseLayout.astro";

const PageTitle = "Home";
const goals = ["reusable layouts","dynamically creating links and pages","the rest of the UI I guess","content management system (can come later)"]


// you can also use {} for hashmaps and use map.array.function instead of array.function inside the code

// remember to use {condition && element} for if/then
//  and only use {condition?element:element} for if/then/else

// CSS variables should be a bit easier with Astro
//  https://docs.astro.build/en/tutorial/2-pages/4/#use-your-first-css-variable
//  https://docs.astro.build/en/guides/styling/#css-variables
---

<BaseLayout pageTitle="Astro - Home" pageHeader="Astro Tutorial" pageSubHeader="I hope this goes well...">
  <div class="p-4 gap-2">
    <strong>Goals for this project so far:</strong>
    {goals.length >=2 && 
    <ol class="pl-8 list-decimal">
      {goals.map((item) => 
        <li class="mt-2">
          {item}
        </li>
      )}
    </ol>
    }
  </div>
</BaseLayout>
