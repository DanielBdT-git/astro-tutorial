---
import "../styles/global.css";
import BaseLayout from "../layouts/baseLayout.astro";
import { getCollection } from "astro:content";

// const articleArray = await getCollection("articles"); this name lives in the Astro config file!

// you need to sort the array before using it - this was also in the docs
// https://docs.astro.build/en/guides/content-collections/#querying-build-time-collections
const articleArray = (await getCollection('articles')).sort(
  (a,b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!-- TODO: fix error and finish implementing content collection -->

<BaseLayout pageTitle="News" pageHeader="News Articles" pageSubHeader="This is where all the news lives :)">
  <main class="p-4">
    {articleArray.length >= 2 &&
    <ul class="text-sky-900 *:first:rounded-t-lg *:last:rounded-b-lg">
      {articleArray.map((article) => 
        <li class="mb-1 hover:underline cursor-pointer p-2 border border-black">
          <a href={`/articles/${article.id}`}>
            {article.data.title}
          </a>
        </li>
      )}
    </ul>
    }
    <div class="flex flex-col p-4 gap-2">
      <span>I need to learn how to make all that stuff dynamic in the future.</span>
      <span>articleArray contains {articleArray.length} items.</span>
    </div>
  </main>
</BaseLayout>
